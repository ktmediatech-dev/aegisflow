# --- Shared Postgres database ---
# One physical database holds everything: platform metadata (companies,
# platform_admins, directory) in its "public" schema, plus one Postgres
# SCHEMA per company for isolation (see src/db/tenantDb.js for why this
# is schema-per-company rather than database-per-company — most managed/
# shared Postgres hosting doesn't grant CREATE DATABASE to app users, but
# CREATE SCHEMA within your own database works fine).
# This database must already exist — create it once via your hosting
# panel (or `createdb`/psql locally); nothing here creates it for you.
PG_DB_NAME=aegisflow

# --- App connection (also used to create each company's schema) ---
PG_APP_HOST=localhost
PG_APP_PORT=5432
PG_APP_USER=postgres
PG_APP_PASSWORD=changeme

# --- Auth ---
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Bootstrap platform admin (used once by seedPlatformAdmin.js) ---
BOOTSTRAP_ADMIN_EMAIL=you@aegisflow.com
BOOTSTRAP_ADMIN_PASSWORD=changeme123
BOOTSTRAP_ADMIN_NAME=Platform Admin
